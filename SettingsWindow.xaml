<Window x:Class="ComicViewer.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="设置" Height="640" Width="470"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="#1a1a1a">
    <Window.Resources>
        <Style x:Key="SettingsButton" TargetType="Button">
            <Setter Property="Background" Value="#333"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="#eee"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#44ffffff"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="DarkBox" TargetType="TextBox">
            <Setter Property="Foreground" Value="#eee"/>
            <Setter Property="Background" Value="#333"/>
            <Setter Property="BorderBrush" Value="#555"/>
            <Setter Property="CaretBrush" Value="#eee"/>
            <Setter Property="Height" Value="26"/>
            <Setter Property="Padding" Value="4,0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#eee"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,6,0,8"/>
        </Style>
        <Style x:Key="Hint" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#888"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
    </Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="ComicViewer 设置" FontSize="18" FontWeight="Bold"
                   Foreground="#eee" Margin="0,0,0,12"/>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="0,0,6,0">
                <TextBlock Style="{StaticResource SectionTitle}" Text="显示与外观" Margin="0,0,0,8"/>
                <TextBlock Text="漫画图片宽度 = 阅读区宽度 × 百分比" Foreground="#ccc"
                           FontSize="13" Margin="0,0,0,4"/>
                <Slider x:Name="WidthSlider" Minimum="0.1" Maximum="1.0"
                        TickFrequency="0.05" IsSnapToTickEnabled="True"
                        ValueChanged="WidthSlider_OnValueChanged"/>
                <TextBlock x:Name="WidthLabel" Text="75%" Foreground="#eee"
                           FontSize="13" HorizontalAlignment="Center" Margin="0,2,0,12"/>

                <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                    <TextBlock Text="漫画页面间距" Foreground="#ccc" FontSize="13"
                               VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <TextBox x:Name="PageGapBox" Width="64" Style="{StaticResource DarkBox}"/>
                    <TextBlock Text="px（0 ~ 40）" Style="{StaticResource Hint}" Margin="8,0,0,0"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                    <TextBlock Text="阅读区背景色" Foreground="#ccc" FontSize="13"
                               VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <ComboBox x:Name="BgColorCombo" Width="170" Height="26"
                              SelectedValuePath="Tag">
                        <ComboBoxItem Content="深灰（默认 #1a1a1a）" Tag="#1a1a1a"/>
                        <ComboBoxItem Content="纯黑（#000000）" Tag="#000000"/>
                        <ComboBoxItem Content="护眼深绿（#1a221c）" Tag="#1a221c"/>
                        <ComboBoxItem Content="深蓝灰（#1b1f26）" Tag="#1b1f26"/>
                        <ComboBoxItem Content="柔和浅灰（#e8e8e8）" Tag="#e8e8e8"/>
                    </ComboBox>
                </StackPanel>

                <TextBlock Style="{StaticResource SectionTitle}" Text="滚动与预加载"/>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                    <TextBlock Text="滚轮滚动步长" Foreground="#ccc" FontSize="13"
                               VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <TextBox x:Name="ScrollStepBox" Width="76" Style="{StaticResource DarkBox}"/>
                    <TextBlock Text="px（50 ~ 5000）" Style="{StaticResource Hint}" Margin="8,0,0,0"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                    <TextBlock Text="自动滚动速度" Foreground="#ccc" FontSize="13"
                               VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <TextBox x:Name="AutoScrollSpeedBox" Width="76" Style="{StaticResource DarkBox}"/>
                    <TextBlock Text="px/秒（20 ~ 3000，A 键开关）" Style="{StaticResource Hint}" Margin="8,0,0,0"/>
                </StackPanel>

                <TextBlock Text="漫画预加载页数（离屏图片自动释放，0 ~ 50）" Foreground="#ccc"
                           FontSize="13" Margin="0,2,0,6"/>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                    <TextBlock Text="上" Foreground="#ccc" FontSize="13"
                               VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <TextBox x:Name="PreloadUpBox" Width="60" Style="{StaticResource DarkBox}"/>
                    <TextBlock Text="页，下" Foreground="#ccc" FontSize="13"
                               VerticalAlignment="Center" Margin="8,0,6,0"/>
                    <TextBox x:Name="PreloadDownBox" Width="60" Style="{StaticResource DarkBox}"/>
                    <TextBlock Text="页" Style="{StaticResource Hint}" Margin="8,0,0,0"/>
                </StackPanel>

                <TextBlock Style="{StaticResource SectionTitle}" Text="图片模式"/>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                    <TextBlock Text="默认适应方式" Foreground="#ccc" FontSize="13"
                               VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <ComboBox x:Name="FitModeCombo" Width="170" Height="26"
                              SelectedValuePath="Tag">
                        <ComboBoxItem Content="适应窗口（完整显示）" Tag="FitWindow"/>
                        <ComboBoxItem Content="适应宽度" Tag="FitWidth"/>
                        <ComboBoxItem Content="1:1 原始大小" Tag="ActualSize"/>
                    </ComboBox>
                </StackPanel>
                <CheckBox x:Name="DualPageCheck" Content="双页并排显示（快捷键 D）"
                          Foreground="#eee" FontSize="13" Margin="0,0,0,8"/>
                <CheckBox x:Name="RtlCheck" Content="双页从右到左排列 · 日漫顺序（快捷键 M）"
                          Foreground="#eee" FontSize="13" Margin="0,0,0,12"/>

                <TextBlock Style="{StaticResource SectionTitle}" Text="启动与行为"/>
                <CheckBox x:Name="FullscreenCheck" Content="打开软件时自动全屏"
                          Foreground="#eee" FontSize="13" Margin="0,0,0,8"/>
                <CheckBox x:Name="TruncateCheck" Content="打开单张图片时丢弃其前面的图片（仅向后翻页）"
                          Foreground="#eee" FontSize="13" Margin="0,0,0,8"/>
                <CheckBox x:Name="ConfirmDeleteCheck" Content="删除图片移入回收站前弹出确认提示"
                          Foreground="#eee" FontSize="13" Margin="0,0,0,12"/>

                <TextBlock Style="{StaticResource SectionTitle}" Text="文件关联"/>
                <TextBlock x:Name="AssocStatus" Foreground="#aaa" FontSize="12"
                           Margin="0,0,0,8" TextWrapping="Wrap"/>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                    <Button Content="关联图片类型" Width="120" Height="30" Margin="0,0,8,0"
                            Style="{StaticResource SettingsButton}"
                            Click="BtnAssoc_OnClick"/>
                    <Button x:Name="BtnUnassoc" Content="取消关联" Width="88" Height="30"
                            Style="{StaticResource SettingsButton}"
                            Click="BtnUnassoc_OnClick"/>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right"
                    Margin="0,14,0,0">
            <Button Content="保存" Width="80" Height="32" Margin="0,0,8,0"
                    Style="{StaticResource SettingsButton}"
                    Click="BtnSave_OnClick"/>
            <Button Content="取消" Width="80" Height="32"
                    Style="{StaticResource SettingsButton}"
                    Click="BtnCancel_OnClick"/>
        </StackPanel>
    </Grid>
</Window>
