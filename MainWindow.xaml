<Window x:Class="ComicViewer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ComicViewer"
        Height="800" Width="1200"
        WindowStyle="None"
        ResizeMode="NoResize"
        WindowStartupLocation="Manual"
        Background="#1a1a1a"
        WindowState="Maximized"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        Loaded="MainWindow_OnLoaded"
        KeyDown="MainWindow_OnKeyDown"
        MouseMove="MainWindow_OnMouseMove"
        Closing="MainWindow_OnClosing"
        AllowDrop="True"
        Drop="MainWindow_OnDrop"
        PreviewMouseWheel="MainWindow_OnPreviewMouseWheel"
        PreviewMouseDown="MainWindow_OnPreviewMouseDown"
        PreviewMouseUp="MainWindow_OnPreviewMouseUp">

    <Window.Resources>
        <!-- 侧栏深色细滚动条样式 -->
        <Style x:Key="SidebarScrollBar" TargetType="ScrollBar">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Width" Value="6"/>
            <Setter Property="MinWidth" Value="6"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Grid Background="Transparent">
                            <Track x:Name="PART_Track" IsDirectionReversed="True" Focusable="False">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="{x:Static ScrollBar.PageUpCommand}"
                                                  Template="{x:Null}" Focusable="False"
                                                  Opacity="0"/>
                                </Track.DecreaseRepeatButton>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="{x:Static ScrollBar.PageDownCommand}"
                                                  Template="{x:Null}" Focusable="False"
                                                  Opacity="0"/>
                                </Track.IncreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb x:Name="Thumb" Focusable="False">
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Border x:Name="Bd"
                                                        Background="#55ffffff"
                                                        CornerRadius="3"
                                                        Margin="1,0"/>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="Bd" Property="Background" Value="#88ffffff"/>
                                                    </Trigger>
                                                    <Trigger Property="IsDragging" Value="True">
                                                        <Setter TargetName="Bd" Property="Background" Value="#ccffffff"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="Orientation" Value="Horizontal">
                    <Setter Property="Width" Value="Auto"/>
                    <Setter Property="Height" Value="6"/>
                    <Setter Property="MinHeight" Value="6"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="ScrollBar">
                                <Grid Background="Transparent">
                                    <Track x:Name="PART_Track" IsDirectionReversed="False" Focusable="False">
                                        <Track.DecreaseRepeatButton>
                                            <RepeatButton Command="{x:Static ScrollBar.PageLeftCommand}"
                                                          Template="{x:Null}" Focusable="False"
                                                          Opacity="0"/>
                                        </Track.DecreaseRepeatButton>
                                        <Track.IncreaseRepeatButton>
                                            <RepeatButton Command="{x:Static ScrollBar.PageRightCommand}"
                                                          Template="{x:Null}" Focusable="False"
                                                          Opacity="0"/>
                                        </Track.IncreaseRepeatButton>
                                        <Track.Thumb>
                                            <Thumb x:Name="Thumb" Focusable="False">
                                                <Thumb.Template>
                                                    <ControlTemplate TargetType="Thumb">
                                                        <Border x:Name="Bd"
                                                                Background="#55ffffff"
                                                                CornerRadius="3"
                                                                Margin="0,1"/>
                                                        <ControlTemplate.Triggers>
                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                <Setter TargetName="Bd" Property="Background" Value="#88ffffff"/>
                                                            </Trigger>
                                                            <Trigger Property="IsDragging" Value="True">
                                                                <Setter TargetName="Bd" Property="Background" Value="#ccffffff"/>
                                                            </Trigger>
                                                        </ControlTemplate.Triggers>
                                                    </ControlTemplate>
                                                </Thumb.Template>
                                            </Thumb>
                                        </Track.Thumb>
                                    </Track>
                                </Grid>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- 透明无背景的按钮样式 -->
        <Style x:Key="TopButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="#eee"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#44ffffff"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <!-- 顶部工具栏：绝对定位覆盖层（不占布局），显示时不影响下方图片位置。 -->
        <Border x:Name="TopBar" Background="#40000000"
                Height="34" VerticalAlignment="Top"
                Panel.ZIndex="20"
                MouseLeftButtonDown="TopBar_OnMouseLeftButtonDown">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"
                        VerticalAlignment="Center" Margin="0,0,6,0">
                <Button x:Name="BtnToggleMode" Width="110" Height="26"
                        Margin="4,0" Content="图片模式"
                        Style="{StaticResource TopButton}"
                        Click="BtnToggleMode_OnClick"/>
                <Button x:Name="BtnSettings" Width="70" Height="26"
                        Margin="4,0" Content="设置"
                        Style="{StaticResource TopButton}"
                        Click="BtnSettings_OnClick"/>
            </StackPanel>
        </Border>

        <!-- 主内容区 -->
        <Grid>
            <!-- 漫画模式：连续垂直滚动列表，虚拟化保证流畅 -->
            <ScrollViewer x:Name="ComicScroll"
                          VerticalScrollBarVisibility="Hidden"
                          HorizontalScrollBarVisibility="Hidden"
                          Background="#1a1a1a"
                          CanContentScroll="True"
                          PanningMode="VerticalOnly"
                          Focusable="False"
                          IsManipulationEnabled="False">
                <ItemsControl x:Name="ComicList">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <VirtualizingStackPanel IsVirtualizing="True"
                                                     VirtualizationMode="Recycling"
                                                     Orientation="Vertical"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Image Source="{Binding Source}"
                                   Width="{Binding DisplayWidth}"
                                   Height="{Binding DisplayHeight}"
                                   Stretch="Uniform"
                                   HorizontalAlignment="Center"
                                   RenderOptions.BitmapScalingMode="HighQuality"
                                   Margin="0,2"/>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <!-- 图片模式：单张显示，自适应 -->
            <Grid x:Name="ImagePanel" Background="#1a1a1a"
                  RenderTransformOrigin="0.5,0.5">
                <Grid.RenderTransform>
                    <ScaleTransform x:Name="ImageScale"/>
                </Grid.RenderTransform>
                <Image x:Name="SingleImage"
                       Stretch="Uniform"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       RenderOptions.BitmapScalingMode="HighQuality"/>
            </Grid>
        </Grid>

        <!-- 左侧文件目录侧栏：本级平铺列表 + 返回上一级。全屏时鼠标移至左侧出现；非全屏默认显示。 -->
        <Border x:Name="Sidebar"
                HorizontalAlignment="Left" VerticalAlignment="Stretch"
                Width="240" Background="#2b2b2b"
                BorderBrush="#444" BorderThickness="0,0,1,0"
                Visibility="Collapsed"
                Panel.ZIndex="10">
            <Border.Resources>
                <Style TargetType="ScrollBar" BasedOn="{StaticResource SidebarScrollBar}"/>
            </Border.Resources>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0" x:Name="SidebarTitle" Text="文件目录"
                           Foreground="#eee" FontSize="14" FontWeight="SemiBold"
                           Margin="14,10,0,8" TextTrimming="CharacterEllipsis"/>
                <Button Grid.Row="1" x:Name="BtnUp" Content="↑ 返回上一级"
                        Height="28" Margin="8,0,8,8"
                        Style="{StaticResource TopButton}"
                        HorizontalContentAlignment="Left"
                        Click="BtnUp_OnClick"/>
                <ScrollViewer x:Name="SidebarScroll" Grid.Row="2"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled"
                              Background="Transparent" Focusable="False">
                    <StackPanel x:Name="FolderList" Orientation="Vertical"/>
                </ScrollViewer>
            </Grid>
        </Border>

        <!-- 状态栏：显示当前文件信息，悬浮于右下角。全屏时隐藏。 -->
        <Border x:Name="StatusBar"
                HorizontalAlignment="Right" VerticalAlignment="Bottom"
                Panel.ZIndex="15"
                Margin="0,0,12,12" Background="#80000000"
                CornerRadius="6" Padding="10,4"
                Visibility="Collapsed">
            <TextBlock x:Name="StatusText" Foreground="#eee" FontSize="12"/>
        </Border>
    </Grid>
</Window>
